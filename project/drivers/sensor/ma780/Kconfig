menuconfig MA780
	bool "MA780 sensor"
	default y
	depends on DT_HAS_MPS_MA780_ENABLED
	select SPI
	help
	  Enable driver for MA780 Low-Power Angle Sensor.

if MA780

choice
	prompt "Trigger mode"
	default MA780_TRIGGER_NONE
	help
	  Specify the type of triggering used by the driver.

config MA780_TRIGGER_NONE
	bool "No trigger"

config MA780_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	select MA780_TRIGGER

config MA780_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	select MA780_TRIGGER

endchoice

config MA780_TRIGGER
	bool

config MA780_THREAD_PRIORITY
	int "Thread priority"
	depends on MA780_TRIGGER_OWN_THREAD && MA780_TRIGGER
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config MA780_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on MA780_TRIGGER_OWN_THREAD && MA780_TRIGGER
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # MA780
