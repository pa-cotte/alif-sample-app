 *
 * USB Mass Storage overlay for the Alif E7 DK (RTSS-HE):
 *  - enable the DWC3 USB device controller and gate its PHY power on,
 *  - declare a 96 KiB RAM-backed disk exposed as the MSC LUN "RAM".
 */

#include <dt-bindings/misc/alif_aipm_common.h>

&aipm_run_default {
	phy-pwr-gating = <ALIF_PHY_GATE_USB_MASK>;
};

&ns {
	status = "okay";
};

zephyr_udc0: &usb {
	status = "okay";
};

/ {
	ramdisk0 {
		compatible = "zephyr,ram-disk";
		disk-name = "RAM";
		sector-size = <512>;
		sector-count = <192>;
	};
};
