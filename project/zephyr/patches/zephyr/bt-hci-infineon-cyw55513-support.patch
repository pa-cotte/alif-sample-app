diff --git a/drivers/bluetooth/hci/Kconfig.infineon b/drivers/bluetooth/hci/Kconfig.infineon
index 92b7f29f8fa..c09ab1db4d0 100644
--- a/drivers/bluetooth/hci/Kconfig.infineon
+++ b/drivers/bluetooth/hci/Kconfig.infineon
@@ -190,6 +190,35 @@ config CYW20829_BT_FW_ISOC_TX10
 endchoice
 endif # CYW20829
 
+choice BT_CYW55500_MODULE
+	prompt "CYW55500 BT module"
+	depends on CYW55500 && BT_H4
+
+config BT_CYW55513IUBG_SM
+	bool "CYW55513 Module"
+	help
+	  AIROC CYW55513 Wi-Fi & Bluetooth is a low-power, single chip device
+	  that supports single-stream, tri-band Wi-Fi 6/6E (IEEE 802.11ax)
+	  Wi-Fi MAC/baseband/radio, and Bluetooth/Bluetooth Low Energy 5.4.
+
+config BT_CYW55513_MURATA_2FY
+	bool "CYW55513 Murata 2FY Module"
+	help
+	  Type 2FY is a small and high performance module based on Infineon
+	  CYW55513 combo chipset which supports Wi-Fi 802.11a/b/g/n/ac/ax +
+	  Bluetooth 5.4 BR/EDR/LE.
+
+	  Detailed information about Murata Type 2FY module can be found on
+	  https://www.murata.com/en-us/products/connectivitymodule/wi-fi-bluetooth/overview/lineup/type2fy
+endchoice
+
+config BT_CYW555XX
+	bool "Bluetooth support for CYW555XX"
+	default y if BT_CYW55513_MURATA_2FY || BT_CYW55513IUBG_SM
+	help
+	  Common Bluetooth configuration for CYW555XX-based designs,
+	  including Murata 2FY modules and discrete chip implementations.
+
 config AIROC_CUSTOM_FIRMWARE_HCD_BLOB
 	string  "Path to user BT firmware HCD file"
 	help
diff --git a/drivers/bluetooth/hci/h4_ifx_cyw43xxx.c b/drivers/bluetooth/hci/h4_ifx_cyw43xxx.c
index 6bc563fb9f2..81a0126ebe6 100644
--- a/drivers/bluetooth/hci/h4_ifx_cyw43xxx.c
+++ b/drivers/bluetooth/hci/h4_ifx_cyw43xxx.c
@@ -32,7 +32,7 @@ BUILD_ASSERT(DT_PROP(DT_INST_GPARENT(0), hw_flow_control) == 1,
 		"hw_flow_control must be enabled for HCI H4 UART");
 
 /* BT settling time after power on */
-#define BT_POWER_ON_SETTLING_TIME_MS      (500u)
+#define BT_POWER_ON_SETTLING_TIME_MS      (1500u)
 #define BT_POWER_CBUCK_DISCHARGE_TIME_MS  (300u)
 
 /* Stabilization delay after FW loading */
@@ -44,6 +44,9 @@ BUILD_ASSERT(DT_PROP(DT_INST_GPARENT(0), hw_flow_control) == 1,
 /* Length of UPDATE BAUD RATE command */
 #define HCI_VSC_UPDATE_BAUD_RATE_LENGTH   (6u)
 
+/* Length of Write_SCO_PCM_Int_Param command */
+#define HCI_VSC_WRITE_SCO_PCM_INT_PARAM_LENGTH   (5u)
+
 /* Default BAUDRATE */
 #define HCI_UART_DEFAULT_BAUDRATE         (115200)
 
@@ -56,6 +59,7 @@ enum {
 	BT_HCI_VND_OP_WRITE_RAM                 = 0xFC4C,
 	BT_HCI_VND_OP_LAUNCH_RAM                = 0xFC4E,
 	BT_HCI_VND_OP_UPDATE_BAUDRATE           = 0xFC18,
+	BT_HCI_VND_OP_WRITE_PCM_INT_PARAM       = 0xFC1C,
 };
 
 /*  bt_h4_vnd_setup function.
@@ -162,6 +166,12 @@ static int bt_firmware_download(const uint8_t *firmware_image, uint32_t size)
 		return err;
 	}
 
+	/* Give the controller time to enter download mode before sending
+	 * WRITE_RAM chunks. Empirically required for CYW55513 — without this
+	 * delay the first WRITE_RAM returns status 0x12 (invalid params).
+	 */
+	k_msleep(50);
+
 	/* The firmware image (.hcd format) contains a collection of hci_write_ram
 	 * command + a block of the image, followed by a hci_write_ram image at the end.
 	 * Parse and send each individual command and wait for the response. This is to
@@ -209,6 +219,26 @@ static int bt_firmware_download(const uint8_t *firmware_image, uint32_t size)
 	return 0;
 }
 
+static int bt_update_sco_route(void)
+{
+	struct net_buf *buf;
+
+	/* Allocate buffer for write pcm internal params command */
+	buf = bt_hci_cmd_create(BT_HCI_VND_OP_WRITE_PCM_INT_PARAM,
+				HCI_VSC_WRITE_SCO_PCM_INT_PARAM_LENGTH);
+	if (buf == NULL) {
+		LOG_ERR("Unable to allocate command buffer");
+		return -ENOMEM;
+	}
+
+	/* Zero-initialize to use the default settings */
+	memset(net_buf_add(buf, HCI_VSC_WRITE_SCO_PCM_INT_PARAM_LENGTH), 0,
+	       HCI_VSC_WRITE_SCO_PCM_INT_PARAM_LENGTH);
+
+	/* Send write pcm internal params command. */
+	return bt_hci_cmd_send_sync(BT_HCI_VND_OP_WRITE_PCM_INT_PARAM, buf, NULL);
+}
+
 int bt_h4_vnd_setup(const struct device *dev)
 {
 	int err;
@@ -298,5 +328,19 @@ int bt_h4_vnd_setup(const struct device *dev)
 		}
 	}
 
+	if (IS_ENABLED(CONFIG_BT_CYW555XX)) {
+		/* Update SCO Route to PCM.
+		 * Default route is Transport. In BLE-only mode, the host does
+		 * not populate SCO packet count/size in Host Buffer Size, so
+		 * the controller returns "invalid command". Forcing the route
+		 * to PCM works around the issue.
+		 */
+		err = bt_update_sco_route();
+		if (err) {
+			LOG_ERR("Failed to update SCO route (err %d)", err);
+			return err;
+		}
+	}
+
 	return 0;
 }
