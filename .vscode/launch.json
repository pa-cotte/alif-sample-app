{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Native sim",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/build/zephyr/zephyr.exe"
        },
        {
            "name": "ALIF E7 DK RTSS HP",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/hp/zephyr/zephyr.elf",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServerCLExe",
            "servertype": "jlink",
            "interface": "swd",
            "device": "AE722F80F55D5_HP",
            "toolchainPrefix": "arm-zephyr-eabi",
            "armToolchainPath": "/opt/toolchains/zephyr-sdk-${env:ZEPHYR_SDK_VERSION}/arm-zephyr-eabi/bin",
            "rtos": "Zephyr",
            "showDevDebugOutput": "vscode",
        },
        {
            "name": "ALIF E7 DK RTSS HE",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/he/zephyr/zephyr.elf",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServerCLExe",
            "servertype": "jlink",
            "interface": "swd",
            "device": "AE722F80F55D5_HE",
            "toolchainPrefix": "arm-zephyr-eabi",
            "armToolchainPath": "/opt/toolchains/zephyr-sdk-${env:ZEPHYR_SDK_VERSION}/arm-zephyr-eabi/bin",
            "rtos": "Zephyr",
            "showDevDebugOutput": "vscode",
        },
        {
            "name": "ALIF E7 DK RTSS HP (mcuboot)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/hp/hp_app/zephyr/zephyr.elf",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServerCLExe",
            "servertype": "jlink",
            "interface": "swd",
            "device": "AE722F80F55D5_HP",
            "toolchainPrefix": "arm-zephyr-eabi",
            "armToolchainPath": "/opt/toolchains/zephyr-sdk-${env:ZEPHYR_SDK_VERSION}/arm-zephyr-eabi/bin",
            "rtos": "Zephyr",
            "showDevDebugOutput": "vscode",
        },
        {
            "name": "ALIF E7 DK RTSS HE (mcuboot)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/he/he_app/zephyr/zephyr.elf",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServerCLExe",
            "servertype": "jlink",
            "interface": "swd",
            "device": "AE722F80F55D5_HE",
            "toolchainPrefix": "arm-zephyr-eabi",
            "armToolchainPath": "/opt/toolchains/zephyr-sdk-${env:ZEPHYR_SDK_VERSION}/arm-zephyr-eabi/bin",
            "rtos": "Zephyr",
            "showDevDebugOutput": "vscode",
        }
    ]
}